# ─────────────────────────────────────────────────────────────
# Nextech — template de variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` é ignorado pelo git;
# este arquivo (.env.example) é versionado e NUNCA contém valor real.
#
# Na Vercel, as mesmas chaves são configuradas por ambiente
# (Production / Preview / Development) no painel do projeto.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
# URL canônica do ambiente, usada em metadata/OG e em link absoluto.
#   landing (produção):  https://www.nextech.ia.br
#   painel  (produção):  https://app.nextech.ia.br
#   painel  (staging):    https://staging.nextech.ia.br
# Cada ambiente da Vercel recebe o próprio valor.
# Deixar em branco é seguro (o código usa o padrão), mas preencher evita
# que preview e produção gerem URLs de OG diferentes.
NEXT_PUBLIC_SITE_URL=

# URL do painel, usada pelo botão Login da landing. Em preview/staging,
# apontar para o próprio ambiente para não jogar o usuário na produção.
NEXT_PUBLIC_APP_URL=

# ── Supabase (banco + auth) ──────────────────────────────────
# Painel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: a service_role ignora RLS por definição. Só no servidor,
# nunca com prefixo NEXT_PUBLIC_, nunca importada em componente client.
SUPABASE_SERVICE_ROLE_KEY=

# Token pessoal da Supabase CLI (painel > Account > Access Tokens).
# Autentica `supabase link` e `supabase db push` sem login interativo —
# inclusive no CI. É um token de CONTA, não de projeto: vale para todos os
# projetos que você acessa, então nunca vai para o client nem para log.
SUPABASE_ACCESS_TOKEN=

# Senha do banco Postgres (painel > Settings > Database > Database password).
# Usada pela Supabase CLI em `db push` / `db pull`, que conectam direto no
# Postgres, fora do PostgREST. Sem ela a CLI falha ao criar o papel de login.
# Não é usada pela aplicação: o runtime acessa o banco pelas chaves acima.
SUPABASE_DB_PASSWORD=

# ── IA (OpenRouter) ──────────────────────────────────────────
# O modelo nunca é hardcoded: trocar de provider é mudar esta env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── E-mail transacional (Resend) ─────────────────────────────
# Domínio de envio separado do e-mail humano (Zoho) — ver docs/infra-setup.md
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── WhatsApp Business Platform (Meta Cloud API) ──────────────
# Credenciais do APP Nextech (infraestrutura). O token de cada clínica
# é segredo por tenant, criptografado no banco — não vai em env.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Token que valida o handshake do webhook (você escolhe o valor).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Google Calendar (OAuth por clínica) ──────────────────────
# Credenciais do app OAuth do Nextech. O refresh_token de cada clínica
# é segredo por tenant, criptografado no banco — não vai em env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Billing (Asaas) ──────────────────────────────────────────
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# ── Criptografia de segredo por tenant ───────────────────────
# Chave mestra que cifra credencial de clínica em repouso (regra 8).
# Gerar com: openssl rand -base64 32
# Rotacionar esta chave exige re-cifrar os segredos existentes.
TENANT_SECRETS_ENCRYPTION_KEY=

