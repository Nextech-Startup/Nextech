# Segredos do docker-compose.yml deste diretório (Evolution local do canal de
# demonstração). Copiar para scripts/canal-demo/.env, que fica fora do git.
#
# A chave global da Evolution: cria a instância e abre o painel
# http://localhost:8080/manager. É a mesma EVOLUTION_API_KEY do .env da raiz.
# Gerar com: openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Senha do Postgres próprio da Evolution (só a instância e a sessão do chip).
# Gerar com: openssl rand -hex 24
POSTGRES_PASSWORD=
